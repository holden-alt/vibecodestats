{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "cc-dashboard",
  "account_id": "aa799e6f6a410deff0b83c4d5e0823f6",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc-dashboard-prod",
      "database_id": "3685982c-c582-4c23-9348-0a2309a48e5e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OG_IMAGES",
      "bucket_name": "cc-dashboard-og"
    }
  ]
}
